# Anthropic API キー(サーバー側のみで使用。クライアントには露出しません)
# https://console.anthropic.com/ で取得し、.env.local にコピーして設定してください。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル(任意。未設定なら下記がデフォルト)
# 演習のライブ実行・週末添削に使う上位モデル
MODEL_EXECUTE=claude-sonnet-4-6
# ミニ演習の自動フィードバック・採点に使う低コストモデル
MODEL_GRADE=claude-haiku-4-5-20251001

# β向けフィードバック導線(任意)。NEXT_PUBLIC_ はクライアントに露出するので秘密は入れないこと。
# 感想フォーム(Googleフォーム等)のURL。設定すると「感想を送る」リンクがそこへ飛ぶ。
NEXT_PUBLIC_FEEDBACK_URL=
# フォーム未設定時のフォールバック宛先(メール)。URLが空ならこのアドレスへの mailto: になる。
NEXT_PUBLIC_FEEDBACK_EMAIL=
